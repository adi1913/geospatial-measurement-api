# Copy to .env and adjust. All values are optional; defaults are shown.
APP_NAME=Geospatial File Measurement API
LOG_LEVEL=INFO

# SQLite file (use an absolute path in production)
DATABASE_URL=sqlite:///./geospatial.db

# Where original uploads are stored (keep outside any served/executable folder)
UPLOAD_DIR=./uploads

# Browser origins allowed to call the API (comma-separated; production: your real frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=20
MAX_ZIP_ENTRIES=100
MAX_ZIP_UNCOMPRESSED_MB=200
